OPENAI_API_KEY=put-your-openai-api-key-here
OPENAI_AUDIO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_AUDIO_TITLE_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

APP_NAME=jamkkan-jeju-api
ENVIRONMENT=development
DEBUG=true
CORS_ALLOWED_ORIGINS=http://localhost:3000

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=tour
MYSQL_USER=tour
MYSQL_PASSWORD=tour_password
MYSQL_SSL_ENABLED=false

KTO_BASE_URL=https://apis.data.go.kr/B551011/KorService2
KTO_SERVICE_KEY=put-your-kto-service-key-here
KTO_MOBILE_OS=ETC
KTO_MOBILE_APP=tour-api

AZURE_STORAGE_CONNECTION_STRING=put-your-azure-storage-connection-string-here
AZURE_STORAGE_CONTAINER=jamkkanjeju
